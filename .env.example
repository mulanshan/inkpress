# =============================================================================
# InkPress Environment Configuration
# Copy to .env and customize before deployment. NEVER commit your real .env.
# =============================================================================

# Core
TZ=Asia/Shanghai
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security — MUST be set to strong random values in production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_EXPIRE_HOURS=168

# Optional initial admin bootstrap (can also be configured in the web UI on first launch)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong-password

# PostgreSQL 18 (ParadeDB recommended for BM25 full-text search; standard PG16+ also supported)
DATABASE_URL=postgresql+psycopg://inkpress:change-me@postgres:5432/inkpress

# Redis 7/8 (Taskiq broker, scheduler, SSE pub/sub, cache)
REDIS_URL=redis://redis:6379/5

# Internal sidecar & scraping services
NEWSNOW_BASE_URL=http://newsnow:4444
RSSHUB_BASE_URL=http://rsshub:1200
BYPARR_BASE_URL=http://byparr:8191

# Optional outbound HTTP/SOCKS proxy for overseas sources & AI APIs
# Example: http://192.168.1.10:7890
OUTBOUND_PROXY=

# Persistent library storage path (inside container)
LIBRARY_DATA_DIR=/data/library

# Optional default SMTP settings (can be managed & encrypted via Studio UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
DEFAULT_KINDLE_EMAIL=

# Optional default OpenAI-compatible AI settings (can be managed & encrypted via Studio UI)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENABLED=false
